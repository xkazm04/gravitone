# Public origin this studio is served from, e.g. https://gravitone.your-domain.tld
# (no trailing slash). app/layout.tsx resolves every relative OpenGraph image
# against it — the /t/{id} and /r/{id} share cards. Leave it unset locally;
# unset in a DEPLOYED build means Next falls back to http://localhost:3000 and
# every social-share preview renders a broken image off-platform.
#NEXT_PUBLIC_SITE_URL=

# Gravitone TTS backend the /api/tts proxy talks to.
# Local dev (the Python service): http://127.0.0.1:8080
# Deployed Arm instance:          https://tts.your-domain.tld
GRAVITONE_URL=http://127.0.0.1:8080

# Root API key for the backend — same value as TTS_API_KEY in gravitone/.env.
# It satisfies EVERY scope upstream, `admin` included, so it can mint and revoke
# API keys. Routes ask for it explicitly (`credential: "operator"` in
# lib/backend.ts); it is never attached automatically. Keep it server-only (no
# NEXT_PUBLIC_ prefix) and never paste it into a browser.
GRAVITONE_API_KEY=

# ── Who may manage API keys ─────────────────────────────────────────────────
#
# The studio runs in one of two auth postures, decided by whether a Firebase
# project is configured below:
#
#   SINGLE-USER (no project id)  — your own box, no accounts. /api/keys needs no
#     token; every response carries `X-Gravitone-Auth-Mode: single-user`. This
#     is the default and it is deliberate: the same studio already proxies voice
#     cloning, deletion and synthesis unauthenticated, so gating key minting
#     alone would buy nothing. Do NOT expose such a deployment to the internet.
#
#   FIREBASE (a project id is set) — several people, one process. Every
#     /api/keys call requires a Firebase ID token, verified SERVER-side against
#     Google's public certificates, and each key is scoped to the signed-in uid:
#     you cannot see, rotate, revoke or destroy anyone else's.
#
# No service account is needed — verification uses only the public project id.
# Set FIREBASE_PROJECT_ID if the server should expect a different project from
# the one the browser bundle carries (it takes precedence).
#FIREBASE_PROJECT_ID=

# Firebase web config (from Firebase console → Project settings → Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Error reporting (OFF unless you fill this in) ────────────────────────────
#
# Gravitone runs on a box you own and nothing leaves it. That includes crash
# reports: with NEXT_PUBLIC_SENTRY_DSN and SENTRY_DSN both unset, the Sentry
# SDK is never imported — not on the server, not in the browser — so no
# transport is constructed, no global handler is patched and no request goes
# anywhere. Errors keep going to stdout, exactly as they do today. Turning it
# on is one variable; leaving it off is the default and costs nothing.
#
# Get a DSN from sentry.io → Project → Settings → Client Keys. It is not a
# secret in the credential sense (the browser one ships in the bundle by
# design), but it is YOURS — never commit a real value to this file.
#
# The browser half. Prefixed NEXT_PUBLIC_ because it is inlined at build time;
# set it before `npm run build`, not after.
#NEXT_PUBLIC_SENTRY_DSN=
# The server half (route handlers, server components, middleware). Falls back
# to NEXT_PUBLIC_SENTRY_DSN if unset, so one DSN for both is fine.
#SENTRY_DSN=

# Which deployment an event came from. Defaults to NODE_ENV.
#SENTRY_ENVIRONMENT=
#NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Version stamp on every event — a git sha is the usual choice.
#SENTRY_RELEASE=
#NEXT_PUBLIC_SENTRY_RELEASE=

# Fraction of ERRORS sent, 0..1. Default 1: a tracker that silently drops
# errors turns "we never saw that" into an unreliable statement. Lower it only
# if a quota actually demands it.
#SENTRY_SAMPLE_RATE=1
#NEXT_PUBLIC_SENTRY_SAMPLE_RATE=1

# Performance tracing, 0..1. Default 0 — errors are the accepted scope, and
# transactions are volume with no incident value here. The browser half has no
# equivalent knob at all: client tracing is off by construction.
#SENTRY_TRACES_SAMPLE_RATE=0
