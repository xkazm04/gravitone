# Gravitone TTS backend the /api/tts proxy talks to.
# Local dev (the Python service): http://127.0.0.1:8080
# Deployed Arm instance:          https://tts.your-domain.tld
GRAVITONE_URL=http://127.0.0.1:8080

# Root API key for the backend — same value as TTS_API_KEY in gravitone/.env.
# It satisfies EVERY scope upstream, `admin` included, so it can mint and revoke
# API keys. Routes ask for it explicitly (`credential: "operator"` in
# lib/backend.ts); it is never attached automatically. Keep it server-only (no
# NEXT_PUBLIC_ prefix) and never paste it into a browser.
GRAVITONE_API_KEY=

# ── Who may manage API keys ─────────────────────────────────────────────────
#
# The studio runs in one of two auth postures, decided by whether a Firebase
# project is configured below:
#
#   SINGLE-USER (no project id)  — your own box, no accounts. /api/keys needs no
#     token; every response carries `X-Gravitone-Auth-Mode: single-user`. This
#     is the default and it is deliberate: the same studio already proxies voice
#     cloning, deletion and synthesis unauthenticated, so gating key minting
#     alone would buy nothing. Do NOT expose such a deployment to the internet.
#
#   FIREBASE (a project id is set) — several people, one process. Every
#     /api/keys call requires a Firebase ID token, verified SERVER-side against
#     Google's public certificates, and each key is scoped to the signed-in uid:
#     you cannot see, rotate, revoke or destroy anyone else's.
#
# No service account is needed — verification uses only the public project id.
# Set FIREBASE_PROJECT_ID if the server should expect a different project from
# the one the browser bundle carries (it takes precedence).
#FIREBASE_PROJECT_ID=

# Firebase web config (from Firebase console → Project settings → Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
