# Copy to .env (gitignored) and fill in. service/config.py loads this file
# at startup; real environment variables take precedence over .env entries.

# Root API key. When set, EVERY endpoint (except /health and /metrics)
# requires either this key or a managed key issued via /v1/keys, sent as
# `xi-api-key: <key>` or `Authorization: Bearer <key>`.
# The root key passes all scopes including key management.
# Leave empty to run the service fully open (bare local dev / loadtest).
# Generate one:  python -c "import secrets; print('gvt_root_' + secrets.token_hex(24))"
TTS_API_KEY=

# Optional overrides (defaults in service/config.py):
# TTS_WORKERS=2
# TTS_QUEUE_MAX=32
# TTS_TORCH_THREADS=4
# TTS_HOST=127.0.0.1
# TTS_PORT=8080

# Ingest (voice cloning from a recording). These bound COST and load: a cloud
# scan makes duration-billed ElevenLabs calls plus one batched Gemini call per
# group of segments. Defaults and full rationale in service/config.py.
# INGEST_MAX_JOBS=2              # jobs working at once, per process (over → 429)
# INGEST_MAX_CLIP_SECONDS=900    # recordings longer than this are rejected
# INGEST_LABEL_BATCH=8           # segments per classifier request
# INGEST_RETRY_ATTEMPTS=3        # attempts per external call (transient only)
# INGEST_JOB_RETRY_BUDGET=12     # retries allowed across a whole job
# INGEST_ESCALATION_BUDGET=12    # segments a job may escalate to the pro model

# Speech to text (service/stt.py). Fully local — CTranslate2 int8 on CPU, no
# key, nothing uploaded. Weights download on FIRST use, not at install.
# STT_MODEL=small                # tiny | base | small | medium | large-v3
#                                # small is the smallest that keeps domain nouns
#                                # ("React", "PostgreSQL") intact; base is ~2x
#                                # faster and noticeably worse at exactly those
# STT_COMPUTE_TYPE=int8          # int8 | int8_float32 | float32
# STT_BEAM_SIZE=1                # 1 = greedy; a conversation pays for latency
# STT_THREADS=4                  # keep in step with TTS_TORCH_THREADS
# STT_MAX_CLIP_SECONDS=900       # ceiling on a /v1/speech-to-text upload

# Speaker diarization (service/diarize.py) — who spoke when. sherpa-onnx, no
# HuggingFace account (which is why not pyannote.audio). Fetch the models once:
#   python -m service.diarize --download        (~34 MB)
# DIARIZE_THRESHOLD=0.6          # voice-distance for "different person".
#                                # MEASURED, not guessed: the only value in a
#                                # 0.4-0.8 sweep that got both of sherpa-onnx's
#                                # labelled human fixtures exactly right. There
#                                # is no speaker-count knob — the underlying one
#                                # does not honour it (see service/diarize.py).
# DIARIZE_THREADS=1

# Piper voices (service/piper.py) — a SECOND synthesis engine for the languages
# Pocket TTS cannot speak (it does English + French). Nothing is required; an
# empty directory means every voice comes from Pocket TTS as before.
#   python -m piper.download_voices --download-dir piper_voices cs_CZ-jirka-medium
# PIPER_VOICES_DIR=./piper_voices

# Conversational agents (service/convai.py) — the ElevenLabs-Agents-shaped
# WebSocket. An existing ElevenLabs integration repoints at this service by
# changing ONE base URL; the browser SDK needs no changes.
# CONVAI_ENABLED=1
# CONVAI_LLM=scripted            # scripted | claude-cli | openai-compat
#   scripted      ~1.3-1.7s/turn. Fixed turns, no model. The default, because a
#                 WER or latency assertion needs a deterministic interviewer.
#   claude-cli    ~11-15s/turn. The `claude` CLI headless on this machine's own
#                 subscription: real adaptive conversation, no API key, no server
#                 to run. Runs with tools disabled (see service/dialog.py).
#   openai-compat any local /chat/completions server.
# CLAUDE_CLI_COMMAND=claude
# CLAUDE_CLI_MODEL=haiku         # fastest tier; a screening question needs no more
# CLAUDE_CLI_TIMEOUT_S=60
# CONVAI_LLM_BASE_URL=http://127.0.0.1:11434/v1   # LM Studio / llama.cpp / vLLM
# CONVAI_LLM_MODEL=llama3.2
# CONVAI_LLM_API_KEY=            # only if your local server wants one
# CONVAI_AGENTS_DIR=./agents     # one JSON per agent; built-ins need no files
# CONVAI_MAX_SESSIONS=4          # concurrent conversations (over → socket closed)
# CONVAI_PUBLIC_URL=             # set ONLY behind a proxy/port map, e.g.
#                                # https://tts.example.com → wss://tts.example.com
# CONVAI_AUDIO_RATE=16000        # both directions; what the SDK and Whisper want
# CONVAI_RECORD=0                # write each call's audio + transcript to disk.
#                                # OFF by default on purpose: recording every
#                                # caller unasked is an operator's decision, not
#                                # a default. Turn it ON for test runs — the
#                                # recording IS the deliverable there.
# CONVAI_RECORDINGS_DIR=./recordings

# TTS_LOG_LEVEL=info             # this service's own logs (per-turn latency,
#                                # engine readiness). debug is very chatty.

# ── Error reporting (OFF unless you fill this in) ────────────────────────────
#
# This service runs on a box you own and nothing leaves it. That includes crash
# reports: with SENTRY_DSN unset, `sentry_sdk` is never imported — no transport
# is built, no excepthook is replaced, no socket is opened — and failures go to
# stdout exactly as they do today. Leaving it blank is the default and it costs
# nothing. See service/observability.py.
#
# Get a DSN from sentry.io -> Project -> Settings -> Client Keys. It is yours;
# never commit a real value into this file.
# SENTRY_DSN=

# SENTRY_ENVIRONMENT=production  # which deployment an event came from
# SENTRY_RELEASE=                # version stamp; a git sha is the usual choice

# SENTRY_SAMPLE_RATE=1           # fraction of ERRORS sent, 0..1. Default 1: a
#                                # tracker that silently drops errors turns "we
#                                # never saw that" into an unreliable statement.
#                                # Lower it only if a quota demands it.
# SENTRY_TRACES_SAMPLE_RATE=0    # performance tracing. Default 0 — errors are
#                                # the accepted scope, and this service already
#                                # publishes its own latency on /metrics.

# SENTRY_INGEST_SPEND_EVENTS=1   # one info-level event per finished ingest job
#                                # carrying that job's EXISTING external-call
#                                # ledger (service.ingest.Spend: ElevenLabs
#                                # Scribe + Isolator + Gemini calls, retries,
#                                # escalations), so cloud cost is queryable in
#                                # the same place as errors instead of only in
#                                # an invoice. The ledger is also attached as
#                                # context to any ingest failure regardless of
#                                # this setting. Set 0 to keep the context and
#                                # drop the standalone events.
